---
import { copy, links, type Lang } from '../i18n';
import { socials } from '../lib/socials';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang].contact;
const ui = copy[lang].ui;
const newTab = copy[lang].geo.newTab;
---
<!-- Ink chapter: contact and footer share one ink ground and read as one
     block. Gold is a micro-accent here only (copied feedback, email hover
     underline). -->
<section class="field field--ink contact" id="contacto" aria-labelledby="contact-title">
  <div class="wrap contact-grid">
    <h2 class="t-poster contact-title" id="contact-title">{t.title}</h2>
    <p class="contact-sub">{t.sub}</p>
    <div class="contact-reach">
      <div class="email-row">
        <a class="email" href={`mailto:${links.email}`}><span data-email>{links.email}</span></a>
        <button type="button" class="copy-btn" data-copy={links.email} data-ok={t.copied} data-fail={t.copyFail} aria-label={t.copy}>
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="M7 7h9v9H7z M4 13V4h9" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
        <span class="copy-status" role="status" aria-live="polite" data-copy-status></span>
      </div>
      <ul class="contact-social" aria-label={ui.social}>
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              <svg class="social-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d={s.d} fill="currentColor" /></svg>
              <span class="social-label">{s.name}</span><span class="sr-only"> {newTab}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
