---
import { copy, type Lang } from '../i18n';
import { socials } from '../lib/socials';

interface Props {
  lang: Lang;
  page: 'home' | 'work';
}

const { lang } = Astro.props;
const t = copy[lang].ui;
const newTab = copy[lang].geo.newTab;
---
<!-- On the contact chapter's ink: three icons on the left, the brand line on
     the right, nothing else. The language switch lives in the header only. -->
<footer class="site-footer">
  <div class="wrap footer-row">
    <ul class="footer-social" aria-label={t.social}>
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${s.name} ${newTab}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d={s.d} fill="currentColor" /></svg>
          </a>
        </li>
      ))}
    </ul>
    <p class="footer-copy">SEBASBELMOS © 2026</p>
  </div>
</footer>
