---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/sections.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { asset, base, copy, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  page: 'home' | 'work';
  /** The 404 page: own title, not indexed, no canonical or alternates. */
  notFound?: boolean;
}

const { lang, page, notFound = false } = Astro.props;
const t = copy[lang];
const title = notFound ? t.meta.notFoundTitle : page === 'home' ? t.meta.title : t.meta.workTitle;
const description = page === 'home' ? t.meta.description : t.meta.workDescription;
const site = 'https://sebasbelmos.github.io';
const path = page === 'home' ? '' : 'work/';
const esUrl = `${site}${base}${path}`;
const enUrl = `${site}${base}en/${path}`;
const ogImage = `${site}${base}assets/og-${lang}.png`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F4F1EA" />
    {notFound ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={lang === 'es' ? esUrl : enUrl} />
        <link rel="alternate" hreflang="es" href={esUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={esUrl} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="SEBASBELMOS" />
        <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_GB'} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={lang === 'es' ? esUrl : enUrl} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={t.meta.ogAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <link rel="icon" href={asset('brand-icon.ico')} />
    <link rel="preload" href={asset('fonts/mona-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('motion');
          // If site.ts never runs, show every mark instead of leaving them hidden.
          setTimeout(function () { if (!d.classList.contains('ready')) d.classList.remove('motion'); }, 3000);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.ui.skip}</a>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} page={page} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
